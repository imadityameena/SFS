# ---------- Server ----------
PORT=4000
# Where the React app runs (used for CORS and for the OAuth redirect back)
CLIENT_URL=http://localhost:5173

# Secret used to sign JWTs. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# ---------- OAuth2 (GitHub) ----------
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Dev login lets you sign in with just a username, so you can test
# without setting up GitHub OAuth. Turn it OFF (false) for the final demo.
ALLOW_DEV_LOGIN=true

# ---------- Database ----------
# "json"  stores users and file records in server/data/db.json (good for testing)
# "mongo" stores them in MongoDB, e.g. a free MongoDB Atlas cluster (deployment)
DB_DRIVER=json
MONGODB_URI=
MONGODB_DB=sfs

# ---------- Storage ----------
# "local" stores encrypted blobs in server/data/blobs (good for testing)
# "mongo" stores encrypted blobs in MongoDB (GridFS), using MONGODB_URI above
# "s3"    stores encrypted blobs in AWS S3 or an S3-compatible service
STORAGE_DRIVER=local

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible services (Backblaze B2, Cloudflare R2), e.g.
# https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=

# Max upload size in megabytes
MAX_FILE_MB=50
